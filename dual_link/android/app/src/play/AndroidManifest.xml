<?xml version="1.0" encoding="utf-8"?>
<!-- Play Store build (-Pplay): removes everything only "talk from Phone B" needs. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" tools:node="remove" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" tools:node="remove" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" tools:node="remove" />

    <application>
        <service
            android:name=".ClientService"
            android:foregroundServiceType="specialUse"
            tools:replace="android:foregroundServiceType" />
        <receiver android:name=".VoiceKeyReceiver" tools:node="remove" />
        <receiver android:name=".AdbPairReceiver" tools:node="remove" />
    </application>
</manifest>
